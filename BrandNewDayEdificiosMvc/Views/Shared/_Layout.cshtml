<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Mi Aplicación ASP.NET</title>
    
    <!-- Enlaces directos a los archivos locales por defecto de Visual Studio -->
    <link href="~/Content/bootstrap.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/Site.css" rel="stylesheet" type="text/css" />
    
    @Scripts.Render("~/bundles/modernizr")
</head>

<body>

    <!-- Menú de Navegación solicitado con Bootstrap 5 -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="@Url.Action("Index", "Home")">🏢 Edificios NY</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Home")">Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Barrios")">Barrios</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Edificios")">Edificios</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Contenedor del Cuerpo de la Aplicación -->
    <div class="container content-wrapper mt-4">
        @RenderBody()
    </div>

    <!-- Pie de página -->
    <footer class="bg-light text-center text-secondary py-3 border-top mt-5">
        <div class="container">
            <p class="mb-0">&copy; @DateTime.Now.Year - BrandNewDayEdificiosMvc</p>
        </div>
    </footer>

    <!-- JS de Bootstrap 5 desde CDN (Esencial para que funcionen los menús desplegables y alertas) -->
    <script src="https://jsdelivr.net"></script>

    @RenderSection("scripts", required: false)
</body>
</html>
